<style>
  body{font-family:'Tajawal','Segoe UI',sans-serif;background:#0B5FA5;color:#fff;
    min-height:100vh;margin:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:20px;}
  .box{background:rgba(255,255,255,.08);border-radius:16px;padding:30px 24px;max-width:360px;}
  a{color:#fff;font-weight:700;text-decoration:underline;}
  .loader{width:34px;height:34px;border:4px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;
    margin:0 auto 16px;animation:spin 1s linear infinite;}
  @keyframes spin{to{transform:rotate(360deg);}}
</style>
